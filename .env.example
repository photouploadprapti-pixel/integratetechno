# Copy to .env.local and fill in your Supabase project values.
# NEVER commit .env.local (it is gitignored). See cursor.md for full setup.

NEXT_PUBLIC_SUPABASE_URL=https://txudruypdlhejtmvnihe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only — do not prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database password (Project Settings → Database)
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_REGION=ap-northeast-1

# Prefer pooler URI from Supabase → Database → Connect
DATABASE_URL=postgresql://postgres.txudruypdlhejtmvnihe:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
